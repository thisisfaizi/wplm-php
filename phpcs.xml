<?xml version="1.0"?>
<ruleset name="WPLM PHP SDK">
    <description>PSR-12 coding standard for the WPLM PHP SDK.</description>

    <file>src</file>
    <file>tests</file>

    <arg name="extensions" value="php"/>
    <arg value="np"/>

    <exclude-pattern>*/vendor/*</exclude-pattern>
    <exclude-pattern>tests/fixtures/*</exclude-pattern>

    <rule ref="PSR12"/>

    <!-- All client exceptions intentionally live in one classmap-autoloaded
         file (src/exceptions.php), so allow multiple classes there. -->
    <rule ref="PSR1.Classes.ClassDeclaration.MultipleClasses">
        <exclude-pattern>src/exceptions.php</exclude-pattern>
    </rule>
</ruleset>
