{
    "name": "wplm/sdk",
    "description": "Official PHP SDK for WP License Manager (WPLM), with a turnkey WordPress licensing + auto-update helper.",
    "type": "library",
    "license": "MIT",
    "keywords": ["licensing", "drm", "wordpress", "cryptography", "woocommerce"],
    "homepage": "https://github.com/wplm/wplm-php",
    "require": {
        "php": ">=8.0",
        "ext-sodium": "*",
        "ext-json": "*",
        "ext-curl": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6",
        "phpstan/phpstan": "^1.11",
        "squizlabs/php_codesniffer": "^3.10",
        "php-stubs/wordpress-stubs": "^6.4"
    },
    "autoload": {
        "psr-4": {
            "WPLM\\Client\\": "src/"
        },
        "classmap": [
            "src/exceptions.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "WPLM\\Client\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse",
        "lint": "phpcs"
    },
    "config": {
        "sort-packages": true
    }
}
